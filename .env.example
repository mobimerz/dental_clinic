# Copy this file to .env.local and fill in the values. .env.local is never committed.

# Live domain, used for Open Graph URLs
NEXT_PUBLIC_SITE_URL=

# Google Places API (New) key: shows live Google reviews in the Patient Reviews section.
# Leave empty to fall back to src/data/reviews.js.
GOOGLE_PLACES_API_KEY=

# Optional: the clinic's Google place ID. If empty, it is looked up from the clinic name and address.
GOOGLE_PLACE_ID=

# Brevo transactional email (appointment form). BREVO_SENDER_EMAIL must be a verified sender in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=A-Zee Dental
# Inbox that receives appointment requests
CLINIC_INBOX_EMAIL=
